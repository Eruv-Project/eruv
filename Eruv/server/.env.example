# Copy to server/.env and fill in. Never commit server/.env.
# docker compose reads this file twice: as the api container's environment and
# for ${...} substitution in docker-compose.yml (POSTGRES_* below).

# Public HTTPS origin of this server. 203.0.113.10 is a placeholder documentation
# address; replace it with the real AWS address (see README "Where to put the AWS address").
# Keep it identical to the site address in server/Caddyfile.
PUBLIC_BASE_URL=https://203.0.113.10

# PostgreSQL (the compose "db" service). POSTGRES_PASSWORD must equal the password
# inside DATABASE_URL. Use URL-safe characters only, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# PostgreSQL reads POSTGRES_PASSWORD only when its volume is first created;
# changing it later needs ALTER USER inside the database (docs/runbook.md).
POSTGRES_USER=eruv
POSTGRES_DB=eruv
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://eruv:change-me@db:5432/eruv

# Signs app login tokens. Use at least 32 random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional token lifetimes in seconds (defaults shown).
# ACCESS_TOKEN_TTL_S=900
# REFRESH_TOKEN_TTL_S=2592000

# Folder with the shared JSON Schemas. The Docker image sets it to
# /srv/contracts; leave it unset when running from a repo checkout.
# CONTRACTS_DIR=/srv/contracts
