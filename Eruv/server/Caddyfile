# Caddy: HTTPS in front of the api container. WebSocket upgrades (/ws) pass
# through reverse_proxy automatically.
#
# SITE ADDRESS: taken from PUBLIC_BASE_URL in server/.env (docker-compose.yml
# passes it to this container), so the server address is set in one place.
# With a domain name, Caddy gets a public Let's Encrypt certificate by itself
# and renews it. Ports 80 and 443 must reach this machine from the internet,
# and the domain's DNS record must point at its public IP.
#
# Development on a bare IP: see docs/runbook.md "Development on a bare IP".

{$PUBLIC_BASE_URL} {
	encode gzip
	reverse_proxy api:8000
}
